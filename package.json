{
  "name": "gfrr-v28-package",
  "version": "28.0.10",
  "private": true,
  "description": "全球金融风险雷达 v28.0E-0 - Worker-first 实时链路、Brent promotion、sourceProbe、secondary diagnostics 与 fetch timeout guard",
  "type": "module",
  "scripts": {
    "build:data": "node scripts/run-daily-pipeline.mjs",
    "validate": "node scripts/validate-data.mjs",
    "build:realtime": "node scripts/run-realtime.mjs",
    "build:world-order": "node scripts/build-world-order-stress.mjs",
    "check:world-order": "node scripts/check-world-order-stress.mjs",
    "review:world-order": "node scripts/review-world-order-stress.mjs data/world-order-stress.json",
    "diagnose:gdelt": "node scripts/world-order/diagnose-gdelt-source.mjs",
    "diagnose:reliefweb": "node scripts/world-order/diagnose-reliefweb-source.mjs",
    "audit:daily-worker": "node scripts/audit-daily-vs-worker.mjs",
    "audit:stable-observation": "node scripts/audit-stable-observation.mjs",
    "manual:external-ai:build-input": "node scripts/build-external-ai-manual-input.mjs",
    "manual:external-ai:dry-run": "node scripts/run-external-ai-manual-test.mjs --dry-run --input docs/fixtures/external-ai/sample-input-v28.0K-1.json",
    "manual:external-ai:deepseek": "node scripts/run-external-ai-manual-test.mjs --provider deepseek --input docs/fixtures/external-ai/sample-input-v28.0K-1.json --output manual-artifacts/external-ai/deepseek-output-latest.json --allow-network --validate-output",
    "check:worker-health": "node scripts/check-worker-health.mjs",
    "review:worker-health-snapshot": "node scripts/review-worker-health-snapshot.mjs",
    "bump:frontend-asset-version": "node scripts/bump-frontend-asset-version.mjs",
    "check:dom": "node scripts/check-dom-ids.mjs",
    "check:modules": "node scripts/check-module-imports.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:copy": "node scripts/check-copy-contract.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:external-ai-output": "node scripts/check-external-ai-output.mjs",
    "check:external-ai-provider-adapters": "node scripts/check-external-ai-provider-adapters.mjs",
    "check:external-ai-manual-input": "node --check scripts/build-external-ai-manual-input.mjs && npm run manual:external-ai:build-input",
    "check:external-ai-manual-scaffold": "node --check scripts/run-external-ai-manual-test.mjs && node --check scripts/external-ai/provider-adapters.mjs && npm run check:external-ai-provider-adapters && npm run check:external-ai-manual-input && npm run manual:external-ai:dry-run",
    "check:data": "node scripts/validate-data.mjs",
    "check:data:verbose": "node scripts/validate-data.mjs --verbose",
    "check:data:strict-live-alignment": "node scripts/validate-data.mjs --strict-live-alignment",
    "check:all": "npm run check:syntax && npm run check:dom && npm run check:modules && npm run check:copy && npm run check:workflows && npm run check:docs && npm run check:external-ai-output && npm run check:external-ai-manual-scaffold && npm run check:data && npm run check:world-order"
  },
  "engines": {
    "node": ">=24"
  }
}
