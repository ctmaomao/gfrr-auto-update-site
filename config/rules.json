    "geopolitical": { "oilRisk": 0.72, "vixRisk": 0.28 },
    "liquidity": { "dollarRisk": 0.35, "hyRisk": 0.35, "vixRisk": 0.18, "rateRisk": 0.12 },
    "debt": { "realRisk": 0.45, "rateRisk": 0.30, "hyRisk": 0.25 },
    "banking": { "hyRisk": 0.55, "vixRisk": 0.20, "dollarRisk": 0.25 }
