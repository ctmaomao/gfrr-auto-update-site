    "red": {
      "scoreThreshold": 82,
      "brentThreshold": 110,
      "hyThreshold": 4.5,
      "vixThreshold": 28,
      "criticalMissingThreshold": 2
    },
    "yellow": {
      "scoreThreshold": 65,
      "brentThreshold": 90,
      "hyThreshold": 3.7,
      "vixThreshold": 20
    }
  },

  "resetThresholds": {
    "_comment": "从高风险状态恢复到正常所需满足的条件",
    "vixReset": 18,
    "hyReset": 3.7,
    "brentReset": 95
