    "fresh": 30,
    "aging": 90,
    "stale": 360
  },

  "healthScoring": {
    "_comment": "健康分数扣分规则",
    "criticalMissingPenalty": 18,
    "fallbackPenalty": 6,
    "secondarySourcePenalty": 3
  },

  "confidenceScoring": {
    "_comment": "置信度分数扣分规则",
    "criticalMissingPenalty": 14,
    "fallbackPenalty": 4
