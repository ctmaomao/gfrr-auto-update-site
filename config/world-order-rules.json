{
  "version": "1.0.0",
  "scoreWeights": {
    "externalStructural": 0.6,
    "marketConfirmation": 0.3,
    "existingRiskModules": 0.1
  },
  "dimensionWeights": {
    "peaceDividendRetreat": 0.16,
    "blocFormation": 0.2,
    "multiTheaterConflict": 0.24,
    "economicWeaponization": 0.22,
    "capitalControlRisk": 0.18
  },
  "gdelt": {
    "enabled": true,
    "timeoutMs": 9000,
    "maxRecords": 50,
    "maxQueries": 4,
    "throttleMs": 1000,
    "rateLimitRetryMs": 2500,
    "queries": [
      {
        "id": "conflict-theater",
        "labelZh": "多战区冲突报道",
        "query": "(war OR conflict OR military OR strike) (Ukraine OR Russia OR Iran OR Taiwan OR \"Middle East\" OR \"Red Sea\" OR \"South China Sea\" OR \"North Korea\")",
        "dimension": "multiTheaterConflict"
      },
      {
        "id": "sanctions-weaponization",
        "labelZh": "制裁与经济金融武器化",
        "query": "(sanctions OR \"export controls\" OR \"financial restrictions\" OR blacklist OR OFAC)",
        "dimension": "economicWeaponization"
      },
      {
        "id": "chokepoint",
        "labelZh": "封锁、海峡与关键通道",
        "query": "(blockade OR Strait OR \"Red Sea\" OR \"South China Sea\" OR \"Taiwan Strait\")",
        "dimension": "blocFormation"
      },
      {
        "id": "bloc-formation",
        "labelZh": "阵营化与联盟硬化",
        "query": "(alliance OR NATO OR AUKUS OR BRICS OR decoupling OR \"supply chain\")",
        "dimension": "blocFormation"
      }
    ]
  },
  "ofac": {
    "enabled": true,
    "timeoutMs": 9000,
    "recentActionsUrl": "https://ofac.treasury.gov/recent-actions"
  },
  "sipri": {
    "enabled": true,
    "mode": "manual_normalized_import",
    "normalizedInputPath": "config/world-order-sipri-normalized.json"
  },
  "acled": {
    "enabled": true,
    "timeoutMs": 9000,
    "apiBaseUrl": "https://api.acleddata.com/acled/read"
  },
  "marketConfirmation": {
    "goldHigh": 2400,
    "goldVeryHigh": 3000,
    "brentPressure": 95,
    "brentHighPressure": 110,
    "vixElevated": 20,
    "vixHigh": 30,
    "dxyStrong": 105,
    "hyOasElevated": 4,
    "hyOasHigh": 6,
    "spxStrong": 6000
  },
  "forbiddenPhrases": [
    "WW3 已确认",
    "世界大战即将爆发",
    "世界大战概率",
    "第三次世界大战已确认",
    "13 步已走",
    "世界大战第几步"
  ]
}
